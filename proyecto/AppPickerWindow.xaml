<Window x:Class="_stick.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vincular una aplicación" Icon="/_stick;component/assets/stick.ico"
        Width="660" Height="540" MinWidth="620" MinHeight="490"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="#211E2B" Foreground="#FFF8E6"
        FontFamily="{StaticResource InterfaceFont}" FontSize="14">
    <Window.Resources>
        <ResourceDictionary Source="/_stick;component/PixelTheme.xaml"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Ayuda" Margin="12,0,0,0" VerticalAlignment="Top"
                    ToolTip="Cómo encontrar el ejecutable" Style="{StaticResource PixelButton}" Click="Help_Click"/>
            <StackPanel>
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontFamily="{StaticResource PixelFont}" FontSize="28" Foreground="{StaticResource Yellow}"/>
                <TextBlock x:Name="Introduction" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Selecciona una aplicación abierta para vincular su biblioteca de notas."/>
            </StackPanel>
        </DockPanel>

        <Border x:Name="Tutorial" Grid.Row="1" Margin="0,0,0,12" Padding="12,8" Visibility="Collapsed"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Yellow}" BorderThickness="2">
            <StackPanel>
                <TextBlock Text="Tu primera biblioteca" FontFamily="{StaticResource PixelFont}" FontSize="23"
                           Foreground="{StaticResource Yellow}"/>
                <TextBlock Text="1. Abre la aplicación a la que quieres añadirle notas." Margin="0,4,0,0"
                           TextWrapping="Wrap" FontFamily="{StaticResource PixelFont}" FontSize="18"/>
                <TextBlock Text="2. Pulsa Actualizar lista si todavía no aparece." Margin="0,3,0,0"
                           TextWrapping="Wrap" FontFamily="{StaticResource PixelFont}" FontSize="18"/>
                <TextBlock Text="3. Selecciónala y pulsa Vincular." Margin="0,3,0,0"
                           TextWrapping="Wrap" FontFamily="{StaticResource PixelFont}" FontSize="18"/>
                <Button Content="Entendido" Click="DismissTutorial_Click" HorizontalAlignment="Right" Margin="0,5,0,0"
                        Style="{StaticResource PixelButton}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <ListBox x:Name="Applications" AutomationProperties.Name="Aplicaciones abiertas"
                     ItemContainerStyle="{StaticResource CollectionRow}" Background="#1B1824"
                     BorderBrush="{StaticResource Outline}" BorderThickness="2" Padding="5"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel ToolTip="{Binding Executable}">
                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource PixelFont}" FontSize="21"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Executable}" FontSize="13" Opacity=".85"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="Status" Text="Buscando aplicaciones abiertas…"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="20"
                       IsHitTestVisible="False"/>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="RefreshButton" DockPanel.Dock="Left" Content="Actualizar lista"
                    Style="{StaticResource PixelButton}" Click="Refresh_Click"/>
            <Button DockPanel.Dock="Left" Content="Buscar archivo…" Margin="8,0,0,0"
                    Style="{StaticResource PixelButton}" Click="Browse_Click"/>
            <Button DockPanel.Dock="Right" Content="Vincular" IsDefault="True" Click="Link_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem, ElementName=Applications}" Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button DockPanel.Dock="Right" Content="Cancelar" IsCancel="True" Margin="0,0,8,0"
                    Style="{StaticResource PixelButton}"/>
        </DockPanel>
    </Grid>
</Window>
