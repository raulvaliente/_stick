<UserControl x:Class="_stick.WelcomeNoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:_stick"
             AutomationProperties.Name="Guía ilustrada de _stick"
             FontFamily="{StaticResource InterfaceFont}" Foreground="#FFF8E6">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/_stick;component/PixelTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="Lilac" Color="#D6B8FF"/>
            <SolidColorBrush x:Key="Peach" Color="#FFAD9B"/>
            <Style x:Key="PixelLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="Foreground" Value="{StaticResource Yellow}"/>
            </Style>
            <Style x:Key="Copy" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="LineHeight" Value="19"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="#2D283B"/>
                <Setter Property="BorderBrush" Value="#514760"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,10"/>
            </Style>
            <Style x:Key="Frame" TargetType="Border">
                <Setter Property="Background" Value="#201C2B"/>
                <Setter Property="BorderBrush" Value="#514760"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,4"/>
            </Style>
            <Geometry x:Key="CursorSprite">M0,0 H3 V3 H6 V6 H9 V9 H12 V12 H15 V15 H10 V20 H7 V15 H4 V12 H0 Z</Geometry>
            <ControlTemplate x:Key="NoteSample" TargetType="ContentControl">
                <Border Background="#FFE275" BorderBrush="#BC9146" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="13"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Border Background="{TemplateBinding Background}" BorderBrush="#C29C55"
                                BorderThickness="0,0,0,1" Padding="4,0">
                            <DockPanel>
                                <TextBlock Text="×" DockPanel.Dock="Right" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                                <TextBlock Text="_stick" FontSize="8" FontWeight="Bold"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="5,4" HorizontalAlignment="Left">
                            <Rectangle Width="27" Height="2" Fill="#9B713C" HorizontalAlignment="Left"/>
                            <Rectangle Width="20" Height="2" Fill="#9B713C" Margin="0,3,0,0" HorizontalAlignment="Left"/>
                            <Rectangle Width="24" Height="2" Fill="#9B713C" Margin="0,3,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </ControlTemplate>
            <Style x:Key="SampleNote" TargetType="ContentControl">
                <Setter Property="Template" Value="{StaticResource NoteSample}"/>
                <Setter Property="Background" Value="#F6D46F"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Width" Value="56"/>
                <Setter Property="Height" Value="40"/>
            </Style>
            <Style x:Key="SampleCursor" TargetType="Path">
                <Setter Property="Data" Value="{StaticResource CursorSprite}"/>
                <Setter Property="Fill" Value="{StaticResource Paper}"/>
                <Setter Property="Stroke" Value="#211D2C"/>
                <Setter Property="StrokeThickness" Value="1"/>
            </Style>
            <Style x:Key="FrameLabel" TargetType="TextBlock" BasedOn="{StaticResource PixelLabel}">
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,1,0,0"/>
            </Style>
            <Storyboard x:Key="GrabMotion">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GrabPointer"
                                               Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                               FillBehavior="Stop">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="3"/>
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.32" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="DragMotion">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MovingNote"
                                               Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                               FillBehavior="Stop">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.10" Value="4"/>
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.20" Value="8"/>
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.30" Value="12"/>
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.58" Value="12"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="DropMotion">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DropPointer"
                                               Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                               FillBehavior="Stop">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="-4"/>
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.24" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimation Storyboard.TargetName="DropCheck" Storyboard.TargetProperty="Opacity"
                                 From="0.35" To="1" Duration="0:0:0.32" FillBehavior="Stop"/>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#211D2C" BorderBrush="#716581" BorderThickness="2">
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
            <Grid Width="756" Height="540" Margin="0" Background="#211D2C" UseLayoutRounding="True">
                <Grid Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="94"/>
                        <RowDefinition Height="152"/>
                        <RowDefinition Height="200"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="#514760" BorderThickness="0,0,0,1" Margin="0,0,0,10">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="74" Height="74" Margin="0,0,15,0"
                                    VerticalAlignment="Top" Background="#332B43"
                                    BorderBrush="#5F5271" BorderThickness="1">
                                <Image Source="/_stick;component/assets/stick.ico" Width="64" Height="64"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       AutomationProperties.Name="Logo de _stick"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="GUÍA DE INICIO   /   _STICK" Style="{StaticResource PixelLabel}"
                                           Foreground="{StaticResource Lilac}" FontSize="14"/>
                                <TextBlock Text="Tus notas, cuando las necesitas" Style="{StaticResource PixelLabel}" FontSize="32"/>
                                <TextBlock Text="Guarda comandos, ideas y recordatorios al lado de cada app."
                                           Style="{StaticResource Copy}" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" BorderBrush="#615370">
                            <StackPanel>
                                <TextBlock Text="01   Vincula una aplicación" Style="{StaticResource PixelLabel}" Foreground="{StaticResource Lilac}"/>
                                <DockPanel Margin="0,8,0,0">
                                    <Canvas DockPanel.Dock="Left" Width="76" Height="54" RenderOptions.EdgeMode="Aliased">
                                        <Rectangle Canvas.Left="4" Canvas.Top="9" Width="56" Height="37" Fill="#181521"/>
                                        <Rectangle Canvas.Left="1" Canvas.Top="5" Width="56" Height="37" Fill="#241F33"
                                                   Stroke="#85739E" StrokeThickness="2"/>
                                        <Rectangle Canvas.Left="3" Canvas.Top="7" Width="52" Height="8" Fill="#483A60"/>
                                        <Path Canvas.Left="7" Canvas.Top="10" Fill="#D6B8FF" Data="M0,0 H3 V2 H0 Z M6,0 H9 V2 H6 Z"/>
                                        <Path Canvas.Left="8" Canvas.Top="20" Stroke="#D6B8FF" StrokeThickness="2"
                                              Data="M0,0 L5,4 0,8 M9,8 H17"/>
                                        <Rectangle Canvas.Left="43" Canvas.Top="25" Width="24" Height="24" Fill="#FFE275"
                                                   Stroke="#211D2C" StrokeThickness="2"/>
                                        <Path Canvas.Left="50" Canvas.Top="32" Fill="#332A3B" Data="M4,0 H6 V4 H10 V6 H6 V10 H4 V6 H0 V4 H4 Z"/>
                                    </Canvas>
                                    <TextBlock Style="{StaticResource Copy}"><Bold>+ Vincular</Bold> conecta una app abierta. Sus notas aparecen al arrancarla y se ocultan al cerrarla.</TextBlock>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" BorderBrush="#615370">
                            <StackPanel>
                                <TextBlock Text="02   Quita una nota de la vista" Style="{StaticResource PixelLabel}" Foreground="{StaticResource Lilac}"/>
                                <DockPanel Margin="0,8,0,0">
                                    <Canvas DockPanel.Dock="Left" Width="76" Height="54" RenderOptions.EdgeMode="Aliased">
                                        <Border Canvas.Left="3" Canvas.Top="10" Width="56" Height="40" Background="#181521"/>
                                        <ContentControl Canvas.Left="0" Canvas.Top="6" Style="{StaticResource SampleNote}"/>
                                        <Rectangle Canvas.Left="43" Canvas.Top="6" Width="13" Height="13"
                                                   Stroke="#574379" StrokeThickness="2"/>
                                        <Path Canvas.Left="48" Canvas.Top="15" Style="{StaticResource SampleCursor}"/>
                                    </Canvas>
                                    <TextBlock Style="{StaticResource Copy}">Pulsa <Bold>×</Bold> para ocultarla y conservar su texto. Elige su biblioteca y pulsa <Bold>Abrir notas</Bold> para volver a verla.</TextBlock>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource Card}" BorderBrush="#956A66" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="03   Arrastra y suelta en la papelera" Style="{StaticResource PixelLabel}" Foreground="{StaticResource Peach}"/>
                            <UniformGrid Columns="3" Margin="0,8,-8,8">
                                <Border Style="{StaticResource Frame}" Margin="0,0,8,0"
                                        MouseEnter="GrabFrame_MouseEnter">
                                    <StackPanel>
                                        <Canvas Width="182" Height="59" RenderOptions.EdgeMode="Aliased">
                                            <Border Canvas.Left="65" Canvas.Top="14" Width="64" Height="42" Background="#15121C"/>
                                            <ContentControl Canvas.Left="61" Canvas.Top="10" Width="64" Height="42"
                                                            Background="#E5B452" Style="{StaticResource SampleNote}"/>
                                            <Path Canvas.Left="53" Canvas.Top="8" Stroke="#D6B8FF" StrokeThickness="2"
                                                  Data="M4,0 H0 V6 M4,18 H0 V12"/>
                                            <Path x:Name="GrabPointer" Canvas.Left="98" Canvas.Top="17" Style="{StaticResource SampleCursor}">
                                                <Path.RenderTransform><TranslateTransform/></Path.RenderTransform>
                                            </Path>
                                        </Canvas>
                                        <TextBlock Text="01  Sujeta el título" Style="{StaticResource FrameLabel}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Frame}" Margin="0,0,8,0"
                                        MouseEnter="DragFrame_MouseEnter">
                                    <StackPanel>
                                        <Canvas Width="182" Height="59" RenderOptions.EdgeMode="Aliased">
                                            <Path Canvas.Left="64" Canvas.Top="26" Fill="#D6B8FF"
                                                  Data="M0,3 H4 V6 H0 Z M8,3 H12 V6 H8 Z M16,3 H25 V0 L31,4.5 25,9 V6 H16 Z"/>
                                            <local:TrashDropVisual Canvas.Left="101" Canvas.Top="11" Width="80" Height="41"/>
                                            <Canvas x:Name="MovingNote" Width="60" Height="56">
                                                <Canvas.RenderTransform><TranslateTransform/></Canvas.RenderTransform>
                                                <ContentControl Canvas.Left="4" Canvas.Top="9" Style="{StaticResource SampleNote}"/>
                                                <Path Canvas.Left="40" Canvas.Top="18" Style="{StaticResource SampleCursor}"/>
                                            </Canvas>
                                        </Canvas>
                                        <TextBlock Text="02  Arrastra al destino" Style="{StaticResource FrameLabel}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Frame}" Margin="0,0,8,0"
                                        MouseEnter="DropFrame_MouseEnter">
                                    <StackPanel>
                                        <Canvas Width="182" Height="59" RenderOptions.EdgeMode="Aliased">
                                            <local:TrashDropVisual Canvas.Left="41" Canvas.Top="7" Width="100" Height="46" IsHighlighted="True"/>
                                            <Path x:Name="DropPointer" Canvas.Left="118" Canvas.Top="27" Style="{StaticResource SampleCursor}">
                                                <Path.RenderTransform><TranslateTransform/></Path.RenderTransform>
                                            </Path>
                                            <Border x:Name="DropCheck" Canvas.Left="145" Canvas.Top="11" Width="19" Height="19"
                                                    Background="#384939" BorderBrush="#7FA98D" BorderThickness="1">
                                                <Path HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#A5EDC8"
                                                      StrokeThickness="2" Data="M0,4 L4,8 10,0"/>
                                            </Border>
                                        </Canvas>
                                        <TextBlock Text="03  Suelta dentro" Style="{StaticResource FrameLabel}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource Copy}" Foreground="{StaticResource Muted}">La papelera aparece al arrastrar. Si quieres deshacer el borrado, selecciona la biblioteca y pulsa <Bold>Restaurar nota</Bold> en el panel.</TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Background="#302940" BorderBrush="#514760" BorderThickness="1" Padding="12,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="TU PRIMER POST-IT" Style="{StaticResource PixelLabel}" FontSize="14"/>
                                <TextBlock Text="Pulsa + arriba para crear una nota en _stick." Style="{StaticResource Copy}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="MUEVE LA BIBLIOTECA" Style="{StaticResource PixelLabel}" FontSize="14" Foreground="{StaticResource Lilac}"/>
                                <TextBlock Text="Ctrl + arrastrar mueve el grupo visible." Style="{StaticResource Copy}" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Viewbox>
    </Border>
</UserControl>
