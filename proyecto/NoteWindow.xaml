<Window x:Class="_stick.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:_stick"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        MinWidth="165" MinHeight="120" WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Icon="/_stick;component/Assets/stick.ico"
        Background="{Binding Background}" FontFamily="{StaticResource InterfaceFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{Binding Foreground}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Width" Value="25"/>
                        <Setter Property="Height" Value="28"/>
                    </Style>
                </StackPanel.Resources>
                <Button Content="+" ToolTip="Nueva nota" AutomationProperties.Name="Nueva nota" Click="New_Click"/>
                <Button Content="◐" ToolTip="Cambiar color" AutomationProperties.Name="Cambiar color" Click="Color_Click"/>
                <Button Content="×" ToolTip="Ocultar nota" AutomationProperties.Name="Ocultar nota" Click="Hide_Click"/>
            </StackPanel>
            <Border Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{Binding Foreground}" FontWeight="SemiBold"/>
            </Border>
        </DockPanel>
        <Grid>
            <TextBox x:Name="Editor" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontSize="15"
                     AutomationProperties.Name="Texto de la nota" Background="{Binding Background}"
                     Foreground="{Binding Foreground}" CaretBrush="{Binding Foreground}"
                     BorderThickness="0" Padding="2" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            <local:MarkdownPreview x:Name="Preview" IsHitTestVisible="False"/>
        </Grid>
    </DockPanel>
    <Window.ContextMenu>
        <ContextMenu FontFamily="{StaticResource InterfaceFont}">
            <MenuItem Header="Eliminar nota…" Click="Delete_Click"/>
        </ContextMenu>
    </Window.ContextMenu>
</Window>
