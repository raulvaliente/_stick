<Window x:Class="_stick.CollectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="_stick" Icon="/_stick;component/Assets/stick.ico"
        Width="740" Height="510" MinWidth="600" MinHeight="470"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="#211E2B" Foreground="#FFF8E6" FontFamily="{StaticResource InterfaceFont}" FontSize="14">
    <Window.Resources>
        <FontFamily x:Key="PixelFont">/_stick;component/Assets/Fonts/#Pixelify Sans, Consolas</FontFamily>
        <SolidColorBrush x:Key="Ink" Color="#262132"/>
        <SolidColorBrush x:Key="Panel" Color="#2D2839"/>
        <SolidColorBrush x:Key="Outline" Color="#716581"/>
        <SolidColorBrush x:Key="Paper" Color="#FFF8E6"/>
        <SolidColorBrush x:Key="Muted" Color="#D0C6DA"/>
        <SolidColorBrush x:Key="Yellow" Color="#FFE275"/>

        <Style x:Key="PixelButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Paper}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Border x:Name="Wash" Background="White" Opacity="0" IsHitTestVisible="False" Margin="2"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            <Border x:Name="FocusRing" Margin="4" BorderBrush="{TemplateBinding Foreground}"
                                    BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Wash" Property="Opacity" Value=".12"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Wash" Property="Background" Value="Black"/>
                                <Setter TargetName="Wash" Property="Opacity" Value=".18"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PixelButton}">
            <Setter Property="Background" Value="{StaticResource Yellow}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Yellow}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>

        <Style x:Key="CollectionRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Paper}"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#423A50"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F5D978"/>
                    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#AD8DF2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PixelCheckBox" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel Background="Transparent">
                            <Border x:Name="Box" DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,9,0"
                                    BorderBrush="{StaticResource Outline}" BorderThickness="2"
                                    Background="{StaticResource Panel}">
                                <Path x:Name="Check" Data="M 1,5 L 4,8 9,2" Stroke="{StaticResource Ink}"
                                      StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      RenderOptions.EdgeMode="Aliased" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Yellow}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Yellow}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Paper}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#AD8DF2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Border Background="#15121D" Margin="4,4,0,0"/>
            <Border Background="{StaticResource Yellow}" BorderBrush="#D19A42" BorderThickness="2"
                    Margin="0,0,4,4" Padding="14,10">
                <DockPanel>
                    <Image DockPanel.Dock="Left" Source="/_stick;component/Assets/stick.ico" Width="48" Height="48"
                           Margin="0,0,14,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <StackPanel VerticalAlignment="Center" TextElement.Foreground="{StaticResource Ink}">
                        <TextBlock Text="_stick" FontFamily="{StaticResource PixelFont}" FontSize="32"/>
                        <TextBlock Text="Notas por aplicación" FontSize="14"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,9" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Añadir aplicación…" Click="Add_Click" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="Renombrar…" Click="Rename_Click" Style="{StaticResource PixelButton}"
                            Margin="8,0,0,0" FontSize="17" Padding="8,5" IsEnabled="{Binding HasSelection}"
                            ToolTip="Cambiar el nombre de la biblioteca y el título de sus notas"/>
                    <Button Content="Ayuda" Click="Help_Click" Style="{StaticResource PixelButton}" Margin="8,0,0,0"
                            ToolTip="Cómo encontrar el archivo .exe de una aplicación"/>
                </StackPanel>
                <TextBlock Text="Aplicaciones" FontFamily="{StaticResource PixelFont}" FontSize="24"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
            </DockPanel>

            <Grid Grid.Row="1">
                <ListBox x:Name="Collections" SelectionChanged="Collections_SelectionChanged"
                         AutomationProperties.Name="Aplicaciones vinculadas" ItemContainerStyle="{StaticResource CollectionRow}"
                         Background="#1B1824" BorderBrush="{StaticResource Outline}" BorderThickness="2" Padding="5"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Resources>
                        <Style x:Key="ScrollPage" TargetType="RepeatButton">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="ScrollBar">
                            <Setter Property="Width" Value="14"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Border Background="#211E2B" BorderBrush="{StaticResource Outline}"
                                                BorderThickness="1" Margin="2,0,0,0">
                                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}"/>
                                                </Track.DecreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border Background="{StaticResource Outline}" Margin="1"/>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}"/>
                                                </Track.IncreaseRepeatButton>
                                            </Track>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel ToolTip="{Binding Executable}">
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource PixelFont}" FontSize="22"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Executable}" Opacity=".85" FontSize="13"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Detección automática pausada" FontSize="13" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Automatic}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=Collections}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Sin aplicaciones vinculadas" FontFamily="{StaticResource PixelFont}"
                               FontSize="22" Foreground="{StaticResource Yellow}" TextAlignment="Center"/>
                    <TextBlock Text="Añade un archivo .exe para abrir sus notas cuando se inicie la aplicación."
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="390" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <WrapPanel>
                <Button Content="Abrir notas" Click="Open_Click" Margin="0,0,8,6" Style="{StaticResource PixelButton}"
                        IsEnabled="{Binding HasSelection}"/>
                <Button Content="Cambiar ejecutable…" Click="Replace_Click" Margin="0,0,8,6"
                        Style="{StaticResource PixelButton}" IsEnabled="{Binding HasSelection}"/>
                <Button Content="{Binding AutomaticAction}" Click="Toggle_Click" Margin="0,0,0,6"
                        Style="{StaticResource PixelButton}" IsEnabled="{Binding HasSelection}"/>
            </WrapPanel>
            <Border BorderBrush="{StaticResource Outline}" BorderThickness="0,1,0,0" Margin="0,7,0,0"
                    Padding="0,11,0,0">
                <CheckBox x:Name="Startup" Foreground="{StaticResource Paper}"
                          Style="{StaticResource PixelCheckBox}" Click="Startup_Click">
                    <TextBlock Text="Iniciar _stick al entrar en Windows"/>
                </CheckBox>
            </Border>
        </StackPanel>
    </Grid>
</Window>
