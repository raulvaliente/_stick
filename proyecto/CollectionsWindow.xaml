<Window x:Class="_stick.CollectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="_stick" Icon="/_stick;component/Assets/stick.ico"
        Width="388" Height="560" WindowStyle="None" ResizeMode="CanMinimize"
        WindowStartupLocation="Manual" ShowInTaskbar="False" Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="#211E2B" Foreground="#FFF8E6" FontFamily="{StaticResource InterfaceFont}" FontSize="14">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/_stick;component/PixelTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PixelCheckBox" TargetType="CheckBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <DockPanel Background="Transparent">
                                <Border x:Name="Box" DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,9,0"
                                        BorderBrush="{StaticResource Outline}" BorderThickness="2"
                                        Background="{StaticResource Panel}">
                                    <Path x:Name="Check" Data="M 1,5 L 4,8 9,2" Stroke="{StaticResource Ink}"
                                          StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RenderOptions.EdgeMode="Aliased" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource Yellow}"/>
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Yellow}"/>
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Paper}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="#AD8DF2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PixelSwitch" TargetType="CheckBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <DockPanel Background="Transparent">
                                <Border x:Name="Track" DockPanel.Dock="Left" Width="32" Height="18" Margin="0,0,9,0"
                                        Padding="2" BorderBrush="{StaticResource Outline}" BorderThickness="2"
                                        Background="{StaticResource Panel}">
                                    <Rectangle x:Name="Thumb" Width="10" HorizontalAlignment="Left" Fill="{StaticResource Muted}"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Yellow}"/>
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource Yellow}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Paper}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Track" Property="BorderBrush" Value="#AD8DF2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#716581" BorderThickness="2">
        <Grid Margin="13">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="#D19A42" BorderThickness="2" Background="{StaticResource Yellow}"
                    Padding="10,7" Margin="0,0,0,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="×" Width="34" MinHeight="32" Padding="0"
                            VerticalAlignment="Center" ToolTip="Ocultar panel" AutomationProperties.Name="Ocultar panel"
                            Style="{StaticResource PixelButton}" Click="Close_Click"/>
                    <Image DockPanel.Dock="Left" Source="/_stick;component/Assets/stick.ico" Width="36" Height="36"
                           Margin="0,0,8,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <StackPanel VerticalAlignment="Center" TextElement.Foreground="{StaticResource Ink}">
                        <TextBlock Text="_stick" FontFamily="{StaticResource PixelFont}" FontSize="26"/>
                        <TextBlock Text="Notas por aplicación" FontSize="12"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,7">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="+ Vincular" Click="Add_Click" Style="{StaticResource PrimaryButton}"
                                MinHeight="32" Padding="9,3" AutomationProperties.Name="Vincular aplicación"/>
                        <Button Content="Borrar" Click="DeleteCollection_Click" Style="{StaticResource PixelButton}"
                                MinHeight="32" Padding="9,3" Margin="6,0,0,0"
                                Foreground="#FFB8AA" BorderBrush="#A37683" IsEnabled="{Binding HasExternalSelection}"
                                ToolTip="Desvincular la aplicación y borrar sus notas"/>
                    </StackPanel>
                    <TextBlock Text="Bibliotecas" FontFamily="{StaticResource PixelFont}" FontSize="21"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                </DockPanel>

                <ListBox Grid.Row="1" x:Name="Collections" SelectionChanged="Collections_SelectionChanged"
                         AutomationProperties.Name="Bibliotecas de notas" ItemContainerStyle="{StaticResource CollectionRow}"
                         Background="#1B1824" BorderBrush="{StaticResource Outline}" BorderThickness="2" Padding="4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Resources>
                        <Style x:Key="ScrollPage" TargetType="RepeatButton">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="ScrollBar">
                            <Setter Property="Width" Value="14"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Border Background="#211E2B" BorderBrush="{StaticResource Outline}"
                                                BorderThickness="1" Margin="2,0,0,0">
                                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}"/>
                                                </Track.DecreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border Background="{StaticResource Outline}" Margin="1"/>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}"/>
                                                </Track.IncreaseRepeatButton>
                                            </Track>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource PixelFont}" FontSize="20"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Opacity=".85" FontSize="12" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Executable}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Executable}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                    <Setter Property="Text" Value="Biblioteca de inicio"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Detección pausada" FontSize="12" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsBuiltIn}" Value="False"/>
                                                        <Condition Binding="{Binding Automatic}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <UniformGrid Columns="2" Rows="3" Margin="0,0,-6,-6">
                    <Button Content="Abrir notas" Click="Open_Click" Margin="0,0,6,6"
                            Style="{StaticResource PixelButton}" FontSize="16" MinHeight="32" Padding="4"
                            IsEnabled="{Binding HasSelection}"/>
                    <Button Content="Renombrar" Click="Rename_Click" Margin="0,0,6,6"
                            Style="{StaticResource PixelButton}" FontSize="16" MinHeight="32" Padding="4"
                            IsEnabled="{Binding HasExternalSelection}"/>
                    <Button Content="Cambiar ejecutable" Click="Replace_Click" Margin="0,0,6,6"
                            Style="{StaticResource PixelButton}" FontSize="16" MinHeight="32" Padding="4"
                            IsEnabled="{Binding HasExternalSelection}"/>
                    <Button Content="{Binding AutomaticAction}" Click="Toggle_Click" Margin="0,0,6,6"
                            Style="{StaticResource PixelButton}" FontSize="16" MinHeight="32" Padding="4"
                            IsEnabled="{Binding HasExternalSelection}"/>
                    <Button Content="Restaurar nota" Click="Restore_Click" Margin="0,0,6,6"
                            ToolTip="Restaura la última nota eliminada de la biblioteca seleccionada"
                            Style="{StaticResource PixelButton}" FontSize="16" MinHeight="32" Padding="4"
                            IsEnabled="{Binding CanRestore}"/>
                    <Button Content="Salir de _stick" Click="Exit_Click" Margin="0,0,6,6"
                            Style="{StaticResource PixelButton}" FontSize="16" MinHeight="32" Padding="4"/>
                </UniformGrid>
                <Border BorderBrush="{StaticResource Outline}" BorderThickness="0,1,0,0"
                        Margin="0,8,0,0" Padding="0,7,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Papelera…" Style="{StaticResource PixelButton}"
                                FontSize="16" MinHeight="32" Padding="7,4" Click="TrashSettings_Click"/>
                        <StackPanel>
                            <CheckBox x:Name="TaskbarIcon" Foreground="{StaticResource Paper}" Margin="0,0,0,6"
                                      Style="{StaticResource PixelSwitch}" Click="TaskbarIcon_Click"
                                      ToolTip="Mantiene _stick en la barra de tareas aunque ocultes el panel">
                                <TextBlock Text="Icono en barra de tareas" FontSize="13"/>
                            </CheckBox>
                            <CheckBox x:Name="Startup" Foreground="{StaticResource Paper}"
                                      Style="{StaticResource PixelCheckBox}" Click="Startup_Click">
                                <TextBlock Text="Iniciar con Windows" FontSize="13"/>
                            </CheckBox>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
